    "output": "public/ocp-ai-nvm-opportunity-map-zh.html",
    "animation": "trace",
    "visual_preset": "editorial",
    "quality_profile": "showcase",
    "viewBox": [
      1000,
      620
    ],
    "legend": {
      "mode": "all",
      "entries": {
        "emphasis": {
          "label": "公開規格要求",
          "visible": true
        },
        "security": {
          "label": "受保護的安全狀態",
          "visible": true
        },
        "default": {
          "label": "具名實作脈絡",
          "visible": true
        },
        "dashed": {
          "label": "候選 fit — 待驗證",
          "visible": true
        },
        "database": {
          "label": "持久狀態",
          "visible": true
        }
      }
    },
    "views": [
      {
        "id": "direct-contracts",
        "label": "直接證據",
        "focus": [
          "trust_specs",
          "platform_mgmt",
          "optical_mgmt",
          "immutable_state",
          "inventory_state",
          "saved_config",
          "otp_decision",
          "platform_nv_decision",
          "module_nv_decision"
