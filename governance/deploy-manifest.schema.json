{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://samhuang68.github.io/nvm-whitepaper-site/governance/deploy-manifest.schema.json",
  "title": "NVM Whitepaper deployment manifest",
  "type": "object",
  "required": ["schemaVersion", "site", "source", "build", "inputs", "artifacts"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "site": { "const": "nvm-whitepaper-site" },
    "source": {
      "type": "object",
      "required": ["repository", "branch", "commit", "tree", "commitTime"],
      "properties": {
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "tree": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "commitTime": { "type": "string", "format": "date-time" }
      }
    },
    "artifacts": {
      "type": "object",
      "required": ["artifactSetSHA256", "files"],
      "properties": {
        "artifactSetSHA256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "files": { "type": "array", "minItems": 1 }
      }
    }
  }
}
